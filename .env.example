# KnightForge environment variables
# Copy to .env and fill in real values.

# SQLite database file (Prisma). Swap for Postgres URL when migrating.
DATABASE_URL=file:./db/custom.db

# Secret used to sign session JWTs (HS256). Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-64-char-random-hex-string

# Public site name shown in the UI (defaults to "KnightForge")
NEXT_PUBLIC_SITE_NAME=KnightForge

# Public URL of the realtime chess socket service (used by the client)
NEXT_PUBLIC_GAME_SERVER=

# Dev convenience: set to "dev" ONLY in local development so
# POST /api/auth/forgot-password returns the reset token in the response
# (there is no mail server in the sandbox). NEVER set this in production.
AUTH_EXPOSE_RESET_TOKEN=
